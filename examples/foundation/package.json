{
  "name": "astack-foundation-reference",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bun scripts/install-hooks.ts",
    "hooks:install": "bun scripts/install-hooks.ts",
    "dev": "bun scripts/development.ts",
    "setup:workos": "bun scripts/workos-setup.ts",
    "dev:backend": "bun scripts/development.ts backend",
    "development:verify": "bun scripts/development-proof.ts",
    "convex:local": "bun scripts/development.ts convex",
    "build": "turbo build",
    "build:mcp-ui": "bun run --cwd apps/mcp-ui build && bun scripts/embed-ui.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "bun scripts/prepare-check.ts && turbo typecheck && tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "check:quick": "bun scripts/check.ts quick",
    "check:affected": "bun scripts/check.ts affected",
    "check:ci": "bun scripts/check.ts ci",
    "readiness": "bun scripts/readiness.ts",
    "trials": "bun scripts/trials.ts",
    "agent-evals": "bun scripts/agent-evals.ts",
    "storybook": "bun run --cwd packages/ui storybook",
    "design:verify": "bun scripts/design-proof.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun scripts/readiness.ts",
    "enforcement": "bun scripts/enforcement.ts",
    "dev:staging": "ASTACK_AUTH_MODE=staging bun scripts/development.ts",
    "auth:verify": "bun scripts/auth-proof.ts",
    "auth:staging": "bun scripts/staging-proof.ts",
    "auth:acceptance": "bun scripts/staging-identity.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "convex": "1.46.0",
    "jose": "6.2.12",
    "zod": "4.6.5",
    "@foundation/domain": "workspace:*",
    "@foundation/backend": "workspace:*",
    "@foundation/ui": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@workos-inc/node": "11.0.0",
    "@workos/emulate": "0.14.0",
    "commander": "15.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
