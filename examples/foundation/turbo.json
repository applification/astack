{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/config/**",
    "eslint.config.mjs",
    "tsconfig.json"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
