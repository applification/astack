# bun run dev supplies the actual local backend URL. Set the cloud URL only in the hosting environment when moving to cloud.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_WORKOS_CLIENT_ID=client_...
VITE_WORKOS_REDIRECT_URI=http://localhost:5173
VITE_WORKOS_DEV_MODE=true
# Deployed web requires dev mode false and a configured custom authentication API domain.
VITE_WORKOS_API_HOSTNAME=
