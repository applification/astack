{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reference-ui": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/ui.mjs"
      ],
      "env": {
        "REFERENCE_UI_DATA": "${PLUGIN_DATA}/reference-preferences.json"
      }
    },
    "reference-events": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/events.mjs"
      ],
      "env": {
        "REFERENCE_DATA": "${PLUGIN_DATA}/reference-events.json"
      }
    }
  }
}
