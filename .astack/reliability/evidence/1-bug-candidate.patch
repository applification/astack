+test('keeps actor ownership and rejects invalid patches without changing data', async () => {
+  await withNotebook(async ({ url, dataFile }) => {
+    await Bun.write(dataFile, JSON.stringify({ notes: existingNotes }));
+    for (const actor of [undefined, 'mallory', 'Alice']) {
+      const actorHeaders = new Headers();
+      if (actor !== undefined) actorHeaders.set('x-actor', actor);
+      for (const method of ['GET', 'POST', 'PATCH']) {
+        const result = await fetch(
+          method === 'PATCH' ? `${url}/alice-target` : url,
+          {
+            method,
+            headers: actorHeaders,
+            ...(method === 'GET'
+              ? {}
+              : { body: JSON.stringify({ done: true }) }),
+          },
+        );
+        expect(result.status).toBe(401);
+      }
+    }
+    for (const { actor, id } of [
+      { actor: 'alice', id: 'bob-target' },
+      { actor: 'bob', id: 'alice-target' },
+      { actor: 'alice', id: 'missing' },
+    ]) {
+      const result = await fetch(`${url}/${id}`, {
+        method: 'PATCH',
+        headers: { 'x-actor': actor },
+        body: JSON.stringify({ done: true }),
+      });
+      expect(result.status).toBe(404);
+    }
+    for (const body of [
+      '{',
+      'null',
+      '[]',
+      '{}',
+      ...['true', 'false', 1, 0, null, {}, []].map((done) =>
+        JSON.stringify({ done }),
+      ),
+      JSON.stringify({ done: true, archived: false }),
+      JSON.stringify({ done: false, actor: 'bob' }),
+    ]) {
+      const result = await fetch(`${url}/alice-target`, {
+        method: 'PATCH',
+        headers,
+        body,
+      });
+      expect(result.status).toBe(400);
+    }
+    expect(await Bun.file(dataFile).json()).toEqual({ notes: existingNotes });
+    const changed = await fetch(`${url}/bob-target`, {
+      method: 'PATCH',
+      headers: { 'x-actor': 'bob' },
+      body: JSON.stringify({ done: true }),
+    });
+    expect(changed.status).toBe(200);
+    expect(await changed.json()).toEqual({
+      note: {
+        id: 'bob-target',
+        title: 'Walk the dog',
+        done: true,
+        archived: true,
+      },
+    });
+    expect(await Bun.file(dataFile).json()).toEqual({
+      notes: existingNotes.map((note) =>
+        note.id === 'bob-target' ? { ...note, done: true } : note,
+      ),
+    });
+  });
+});
