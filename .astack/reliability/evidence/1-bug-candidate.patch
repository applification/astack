+test('preserves create validation and actor-scoped retries across status changes and restart', async () => {
+  await withNotebook(async ({ url, dataFile, restart }) => {
+    for (const body of [
+      '{',
+      'null',
+      '[]',
+      '{}',
+      { title: '', operationId: 'invalid' },
+      { title: '   ', operationId: 'invalid' },
+      { title: 'x'.repeat(121), operationId: 'invalid' },
+      { title: 42, operationId: 'invalid' },
+      { title: 'Valid', operationId: '' },
+      { title: 'Valid', operationId: 'x'.repeat(65) },
+      { title: 'Valid', operationId: 'bad id' },
+      { title: 'Valid', operationId: 42 },
+      { title: 'Valid', operationId: 'invalid', done: true },
+    ]) {
+      const result = await fetch(url, {
+        method: 'POST',
+        headers,
+        body: typeof body === 'string' ? body : JSON.stringify(body),
+      });
+      expect(result.status).toBe(400);
+    }
+    expect(await Bun.file(dataFile).json()).toEqual({ notes: [] });
+    const body = JSON.stringify({
+      title: '  Read a book  ',
+      operationId: 'retry_1-A',
+    });
+    const created = await fetch(url, { method: 'POST', headers, body });
+    expect(created.status).toBe(201);
+    const value: unknown = await created.json();
+    if (
+      !value ||
+      typeof value !== 'object' ||
+      !('note' in value) ||
+      !value.note ||
+      typeof value.note !== 'object' ||
+      !('id' in value.note) ||
+      typeof value.note.id !== 'string'
+    )
+      throw new Error('Invalid create response');
+    const id = value.note.id;
+    const initial = { id, title: 'Read a book', done: false, archived: false };
+    expect(value).toEqual({ note: initial });
+    const retry = await fetch(url, { method: 'POST', headers, body });
+    expect(retry.status).toBe(200);
+    expect(await retry.json()).toEqual({ note: initial });
+    const changed = await fetch(`${url}/${id}`, {
+      method: 'PATCH',
+      headers,
+      body: JSON.stringify({ done: true }),
+    });
+    expect(changed.status).toBe(200);
+    expect(await changed.json()).toEqual({ note: { ...initial, done: true } });
+    await restart();
+    const repeated = await fetch(url, { method: 'POST', headers, body });
+    expect(repeated.status).toBe(200);
+    expect(await repeated.json()).toEqual({ note: { ...initial, done: true } });
+    const conflict = await fetch(url, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify({
+        title: 'Different title',
+        operationId: 'retry_1-A',
+      }),
+    });
+    expect(conflict.status).toBe(409);
+    const bob = await fetch(url, {
+      method: 'POST',
+      headers: { 'x-actor': 'bob' },
+      body,
+    });
+    expect(bob.status).toBe(201);
+    const bobValue: unknown = await bob.json();
+    if (
+      !bobValue ||
+      typeof bobValue !== 'object' ||
+      !('note' in bobValue) ||
+      !bobValue.note ||
+      typeof bobValue.note !== 'object' ||
+      !('id' in bobValue.note) ||
+      typeof bobValue.note.id !== 'string'
+    )
+      throw new Error('Invalid create response');
+    expect(bobValue.note.id).not.toBe(id);
+    expect(bobValue).toEqual({ note: { ...initial, id: bobValue.note.id } });
+    expect(await (await fetch(url, { headers })).json()).toEqual({
+      notes: [{ ...initial, done: true }],
+    });
+    expect(
+      await (await fetch(url, { headers: { 'x-actor': 'bob' } })).json(),
+    ).toEqual({
+      notes: [{ ...initial, id: bobValue.note.id }],
+    });
+    expect(await Bun.file(dataFile).json()).toEqual({
+      notes: [
+        { ...initial, done: true, actor: 'alice', operationId: 'retry_1-A' },
+        {
+          ...initial,
+          id: bobValue.note.id,
+          actor: 'bob',
+          operationId: 'retry_1-A',
+        },
+      ],
+    });
+  });
 });
