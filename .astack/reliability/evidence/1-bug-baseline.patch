+test('persists the exact requested done boolean and preserves other notes', async () => {
+  const target: DiskNote = {
+    id: 'alice-target',
+    actor: 'alice',
+    title: 'Read a book',
+    done: false,
+    archived: false,
+    operationId: 'alice-create',
+  };
+  const otherAlice = {
+    ...target,
+    id: 'alice-other',
+    title: 'Archived note',
+    done: true,
+    archived: true,
+    operationId: 'alice-other-create',
+  };
+  const bob = {
+    ...target,
+    id: 'bob-note',
+    actor: 'bob',
+    title: 'Bob note',
+    operationId: 'bob-create',
+  };
+  await withNotebook(
+    async ({ request, restart, dataFile }) => {
+      const publicNote = ({ id, title, done, archived }: DiskNote) => ({
+        id,
+        title,
+        done,
+        archived,
+      });
+      for (const done of [true, true, false, false]) {
+        const expected = { ...target, done };
+        const updated = await request('PATCH', { done }, 'alice', '/' + target.id);
+        expect(updated.status).toBe(200);
+        expect(await updated.json()).toEqual({ note: publicNote(expected) });
+        expect(JSON.parse(await readFile(dataFile, 'utf8'))).toEqual({
+          notes: [expected, otherAlice, bob],
+        });
+        for (const afterRestart of [false, true]) {
+          if (afterRestart) await restart();
+          expect(await (await request()).json()).toEqual({
+            notes: [publicNote(expected), publicNote(otherAlice)],
+          });
+          expect(await (await request('GET', undefined, 'bob')).json()).toEqual({
+            notes: [publicNote(bob)],
+          });
+        }
+      }
+    },
+    [target, otherAlice, bob],
+  );
+});
