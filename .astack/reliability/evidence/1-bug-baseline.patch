+test('preserves create validation and actor-scoped retries after updates and restart', async () => {
+  await withNotebook(async ({ request, restart, url, dataFile }) => {
+    const operationId = 'same-operation';
+    const created = await request('POST', { title: '  Alice note  ', operationId });
+    expect(created.status).toBe(201);
+    const { note } = await created.json();
+    expect(note.title).toBe('Alice note');
+    expect(note.done).toBe(false);
+    expect(note.archived).toBe(false);
+    const bob = await request('POST', { title: 'Bob note', operationId }, 'bob');
+    expect(bob.status).toBe(201);
+    const { note: bobNote } = await bob.json();
+    expect(bobNote.id).not.toBe(note.id);
+    expect(
+      (await request('PATCH', { done: true }, 'alice', '/' + note.id)).status,
+    ).toBe(200);
+    await restart();
+    const before = await readFile(dataFile, 'utf8');
+    const retry = await request('POST', { title: ' Alice note ', operationId });
+    expect(retry.status).toBe(200);
+    expect(await retry.json()).toEqual({ note: { ...note, done: true } });
+    expect((await request('POST', { title: 'Different', operationId })).status).toBe(
+      409,
+    );
+    const bobRetry = await request('POST', { title: 'Bob note', operationId }, 'bob');
+    expect(bobRetry.status).toBe(200);
+    expect(await bobRetry.json()).toEqual({ note: bobNote });
+    const invalidBodies = [
+      {},
+      null,
+      [],
+      { title: '', operationId },
+      { title: '   ', operationId },
+      { title: 'x'.repeat(121), operationId },
+      { title: 1, operationId },
+      { title: 'New', operationId: '' },
+      { title: 'New', operationId: 'x'.repeat(65) },
+      { title: 'New', operationId: 'bad id' },
+      { title: 'New', operationId: 'é' },
+      { title: 'New', operationId: 1 },
+      { title: 'New', operationId, done: true },
+      { title: 'New', operationId, actor: 'bob' },
+    ];
+    for (const body of invalidBodies) {
+      expect((await request('POST', body)).status).toBe(400);
+    }
+    const malformed = await fetch(url, {
+      method: 'POST',
+      headers: { 'x-actor': 'alice', 'content-type': 'application/json' },
+      body: '{',
+    });
