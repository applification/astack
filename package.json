{
  "name": "astack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node site/check.mjs && bun scripts/check-plugins.ts",
    "check:plugins": "bun scripts/check-plugins.ts",
    "observatory:dev": "bun run --cwd apps/observatory dev",
    "observatory:build": "bun run --cwd apps/observatory build",
    "observatory:check": "tsc6 --noEmit && bun test packages/agent-observability packages/agentlog packages/backend/tests",
    "observatory:storybook": "bun run --cwd apps/observatory storybook",
    "agentlog": "bun packages/agentlog/src/cli.ts",
    "observatory:lint": "eslint apps/observatory/src packages/ui/src",
    "observatory:test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "observatory:test:live": "E2E_TELEMETRY_DISABLED=1 e2e run --config e2e.live.config.ts",
    "observatory:build:storybook": "bun run --cwd apps/observatory build:storybook",
    "agent-evals": "bun examples/foundation/scripts/agent-evals.ts",
    "agent-evals:check": "bun run --cwd examples/foundation typecheck && bun test examples/foundation/tests/agent-evals.test.ts examples/foundation/tests/trials.test.ts examples/foundation/evals/notebook/server.test.ts"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@e2e-dev/web": "0.11.1",
    "@eslint/js": "9.39.4",
    "@shadcn/lint": "0.2.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.60",
    "e2e": "0.15.1",
    "eslint": "9.39.4",
    "jose": "6.2.12",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "zod": "4.6.5"
  }
}
