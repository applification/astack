{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@fixture/ui": ["./views/index.tsx"],
      "@fixture/backend/api": ["./server/api.ts"],
      "@private-backend": ["./server/workItems.ts"]
    },
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": []
  },
  "include": ["views", "model", "server"]
}
